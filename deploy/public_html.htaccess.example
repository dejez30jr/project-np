# ============================================================
#  Fallback .htaccess utk ROOT domain (tanpa ubah Document Root)
# ------------------------------------------------------------
#  Opsi B pada panduan deploy. Taruh file ini sebagai
#  public_html/.htaccess
#
#  Efek: semua request /xxx -> di-rewrite internal ke public/xxx
#        sehingga index.php Laravel di folder public yang dieksekusi.
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect trailing slash (opsional, biar SEO rapi)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Forward semua ke folder public
    RewriteRule ^ public/index.php [L]
</IfModule>
